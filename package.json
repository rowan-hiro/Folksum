{
	"name": "folksum",
	"version": "0.1.0",
	"description": "Financial Intelligence & Record Engine for local-first household finance",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rowan-hiro/Folksum.git"
	},
	"homepage": "https://github.com/rowan-hiro/Folksum#readme",
	"bugs": {
		"url": "https://github.com/rowan-hiro/Folksum/issues"
	},
	"keywords": [
		"finance",
		"ledger",
		"sqlite",
		"tui",
		"llm"
	],
	"bin": {
		"folksum": "dist/channels/cli.js"
	},
	"files": [
		"dist",
		"config.example.json",
		"telegram.example.json",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@grammyjs/runner": "2.0.3",
		"grammy": "1.45.1"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3"
	},
	"scripts": {
		"prebuild": "node scripts/clean-dist.mjs",
		"build": "tsc -p tsconfig.build.json",
		"postbuild": "node scripts/prepare-dist.mjs",
		"prepack": "npm run build",
		"start": "node dist/channels/cli.js tui",
		"chat": "node dist/channels/cli.js chat",
		"reminders": "node dist/channels/cli.js reminders",
		"schedule": "node dist/channels/cli.js schedule",
		"telegram": "node dist/channels/cli.js telegram",
		"dev": "node --experimental-strip-types --experimental-sqlite src/channels/cli.ts tui",
		"test": "node --experimental-strip-types --experimental-sqlite --test",
		"typecheck": "tsc --noEmit",
		"package:verify": "node scripts/verify-package.mjs",
		"release:verify": "npm run typecheck && npm test && npm run package:verify"
	}
}
